{
  "name": "@shimmer-from-structure/react",
  "version": "2.4.3",
  "description": "React adapter for shimmer-from-structure",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest",
    "format": "prettier --write .",
    "prepublishOnly": "cp ../../README.md ."
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@shimmer-from-structure/core": "2.4.4"
  },
  "keywords": [
    "react",
    "shimmer",
    "skeleton",
    "loading"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darula-hpp/shimmer-from-structure.git",
    "directory": "packages/react"
  },
  "author": "Olebogeng Mbedzi",
  "license": "MIT"
}
