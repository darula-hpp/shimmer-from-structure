{
  "name": "@shimmer-from-structure/solid",
  "version": "2.4.3",
  "description": "SolidJS adapter for shimmer-from-structure",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest",
    "format": "prettier --write .",
    "prepublishOnly": "cp ../../README.md ."
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@shimmer-from-structure/core": "2.4.4"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "jsdom": "^27.4.0",
    "solid-js": "^1.9.5",
    "typescript": "^5.3.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-solid": "^2.10.2",
    "vitest": "^4.0.17"
  },
  "keywords": [
    "solid",
    "solidjs",
    "shimmer",
    "skeleton",
    "loading"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darula-hpp/shimmer-from-structure.git",
    "directory": "packages/solid"
  },
  "author": "Olebogeng Mbedzi",
  "license": "MIT"
}
